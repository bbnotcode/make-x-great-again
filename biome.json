{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "organizeImports": { "enabled": true },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": { "noArrayIndexKey": "off" }
    }
  },
  "files": {
    "ignore": [
      "node_modules",
      "dist",
      ".curation-db",
      "fixtures",
      "extension",
      "data",
      "services/edge/src/_generated-css.ts",
      "services/edge/src/styles.css",
      "services/edge/worker-configuration.d.ts"
    ]
  }
}
